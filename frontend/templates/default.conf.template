server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Cache hashed static assets aggressively - fast repeat loads
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Proxy API calls to the backend service (same-origin, avoids CORS + extra DNS/TLS round trip).
    # BACKEND_HOST/BACKEND_PORT are substituted from real env vars at container start
    # (nginx:alpine auto-runs envsubst on every *.template file in /etc/nginx/templates/).
    # This keeps the image portable across any host - docker-compose, EasyPanel, Hostinger, etc -
    # you only ever change the env var, never this file.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback - client-side routing
    location / {
        try_files $uri $uri/ /index.html;
    }
}
